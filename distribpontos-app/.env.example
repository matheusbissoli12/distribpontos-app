# Copie para .env.local (no seu computador) ou cadastre na Vercel (Settings › Environment Variables).

# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app, sem barra no final
NEXT_PUBLIC_SITE_URL=https://app.suaempresa.com.br

# Twilio: SMS do código do balcão (o SMS do login é configurado no Supabase)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# true só para testar o balcão sem enviar SMS (o código aparece na tela). Em produção: false
SMS_DEV_MODE=false

# Tarefa diária (/api/cron): um texto aleatório longo
CRON_SECRET=

# Dados da sua empresa, exibidos nos Termos de uso e privacidade
NEXT_PUBLIC_EMPRESA_NOME=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMAIL_SUPORTE=
NEXT_PUBLIC_EMAIL_PRIVACIDADE=
