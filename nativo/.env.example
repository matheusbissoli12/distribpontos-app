# Mesmo projeto Supabase do site (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public
# Endereço onde o backend Next.js (pasta distribpontos-app) está publicado, sem barra no final.
# Usado para Pix, balcão, convites de equipe e cadastro de distribuidoras.
EXPO_PUBLIC_API_URL=https://app.suaempresa.com.br

# Dados da empresa exibidos em Termos e privacidade
EXPO_PUBLIC_EMPRESA_NOME=
EXPO_PUBLIC_EMPRESA_CNPJ=
EXPO_PUBLIC_EMPRESA_ENDERECO=
EXPO_PUBLIC_EMAIL_SUPORTE=
EXPO_PUBLIC_EMAIL_PRIVACIDADE=
