{
  "expo": {
    "name": "DistribPontos",
    "slug": "distribpontos",
    "scheme": "distribpontos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.distribpontos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.distribpontos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4F7A",
        "foregroundImage": "./assets/icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-app.png",
      "bundler": "metro",
      "output": "single",
      "name": "DistribPontos",
      "themeColor": "#1D4F7A"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4F7A",
          "image": "./assets/icon-app.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
